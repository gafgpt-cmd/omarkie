#!/usr/bin/bash
# Runs Omarkie on Arch's shared Electron. pacman installs it as a dependency; if it was
# removed afterwards, say so loudly and offer the install instead of failing silently.
set -euo pipefail

electron=@ELECTRON@
app=/usr/lib/omarkie/app.asar

if ! command -v "$electron" >/dev/null 2>&1; then
  message="Omarkie cannot start: the $electron package is not installed."
  printf '\n\033[1;31m%s\033[0m\nInstall it with: sudo pacman -S --needed %s\n\n' "$message" "$electron" >&2
  if [[ -t 0 && -t 2 ]]; then
    sudo pacman -S --needed "$electron"
  else
    terminal=false
    notice="The $electron package is missing. Install it with: sudo pacman -S --needed $electron"
    if command -v xdg-terminal-exec >/dev/null 2>&1; then
      terminal=true
      notice="The $electron package is missing. A terminal is opening to install it."
    fi
    if command -v notify-send >/dev/null 2>&1; then
      notify-send --urgency=critical --app-name=Omarkie "Omarkie cannot start" "$notice" || true
    fi
    if $terminal; then
      relaunch=$(printf '%q ' omarkie "$@")
      exec xdg-terminal-exec bash -c "if sudo pacman -S --needed $electron; then setsid -f $relaunch </dev/null >/dev/null 2>&1; else read -rp 'Installation failed. Press Enter to close.'; fi"
    fi
    exit 1
  fi
fi

exec "$electron" "$app" "$@"
