#!/usr/bin/bash
# Reuse Arch's shared Electron without making pacman install another series.
set -euo pipefail

minimum_electron=43
app=/usr/lib/omarkie/app.asar

obsidian_electron() {
  local info=$1 line dependency
  local -a dependencies
  while IFS= read -r line; do
    [[ $line =~ ^Depends[[:space:]]On[[:space:]]*:[[:space:]]*(.*)$ ]] || continue
    read -ra dependencies <<< "${BASH_REMATCH[1]}"
    for dependency in "${dependencies[@]}"; do
      dependency=${dependency%%[<>=]*}
      if [[ $dependency =~ ^electron([1-9][0-9]*)$ ]] && (( BASH_REMATCH[1] >= minimum_electron )); then
        printf '%s\n' "$dependency"
        return
      fi
    done
    return 1
  done <<< "$info"
  return 1
}

electron=
if info=$(LC_ALL=C pacman -Qi obsidian 2>/dev/null); then
  electron=$(obsidian_electron "$info") || electron=
else
  newest=$((minimum_electron - 1))
  installed=$(pacman -Qq 2>/dev/null) || installed=
  while IFS= read -r package; do
    if [[ $package =~ ^electron([1-9][0-9]*)$ ]] && (( BASH_REMATCH[1] > newest )) &&
        command -v "$package" >/dev/null 2>&1; then
      newest=${BASH_REMATCH[1]}
      electron=$package
    fi
  done <<< "$installed"
  if [[ -z $electron ]] && info=$(LC_ALL=C pacman -Si obsidian 2>/dev/null); then
    electron=$(obsidian_electron "$info") || electron=
  fi
fi

if [[ -z $electron ]]; then
  message="Omarkie cannot start: Electron $minimum_electron or newer is required. pacman has no supported Electron series for Obsidian."
  printf '%s\n' "$message" >&2
  if [[ ! -t 0 || ! -t 2 ]] && command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency=critical --app-name=Omarkie "Omarkie cannot start" "$message" || true
  fi
  exit 1
fi

if ! command -v "$electron" >/dev/null 2>&1; then
  message="Omarkie cannot start: the $electron executable is missing."
  printf '\n\033[1;31m%s\033[0m\nInstall it with: sudo pacman -S %s\n\n' "$message" "$electron" >&2
  if [[ -t 0 && -t 2 ]]; then
    sudo pacman -S "$electron"
  else
    terminal=false
    notice="The $electron executable is missing. Install it with: sudo pacman -S $electron"
    if command -v xdg-terminal-exec >/dev/null 2>&1; then
      terminal=true
      notice="The $electron executable is missing. A terminal is opening to install it."
    fi
    if command -v notify-send >/dev/null 2>&1; then
      notify-send --urgency=critical --app-name=Omarkie "Omarkie cannot start" "$notice" || true
    fi
    if $terminal; then
      relaunch=$(printf '%q ' omarkie "$@")
      # The terminal may hang up before the forked child enters its new session.
      exec xdg-terminal-exec bash -c "if sudo pacman -S $electron && command -v $electron >/dev/null 2>&1; then nohup setsid -f $relaunch </dev/null >/dev/null 2>&1; else read -rp 'Installation failed. Press Enter to close.'; fi"
    fi
    exit 1
  fi
fi

exec "$electron" "$app" "$@"
